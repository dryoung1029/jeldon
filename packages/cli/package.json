{
  "name": "@jeldon/cli",
  "version": "0.2.0",
  "description": "The `jeldon` CLI: init, validate, doctor, check-geo-floor. The agent's deterministic 'am I wired correctly?' gate.",
  "type": "module",
  "license": "UNLICENSED",
  "bin": {
    "jeldon": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@jeldon/config": "workspace:*",
    "@jeldon/content-model": "workspace:*",
    "@jeldon/core-scoring": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsup": "^9.0.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
