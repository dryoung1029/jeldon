{
  "name": "@jeldon/cli",
  "version": "0.0.0",
  "description": "The `jeldon` CLI: init (the spawn), validate, doctor (+ registered checks), check-geo-floor, score, brief, benchmark. The agent's deterministic \"am I wired correctly?\" gate.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dryoung1029/jeldon.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/dryoung1029/jeldon#readme",
  "bin": {
    "jeldon": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@jeldon/config": "workspace:*",
    "@jeldon/content-model": "workspace:*",
    "@jeldon/core-scoring": "workspace:*",
    "@jeldon/drafting": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
