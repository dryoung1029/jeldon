{
  "name": "@jeldon/config",
  "version": "0.0.0",
  "description": "The Jeldon Domain Pack contract: types, Zod schema, defaults, pure URL/capability helpers (root, isomorphic) and the jiti loader (`@jeldon/config/load`, Node-only). The single file a new project edits validates against this.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dryoung1029/jeldon.git",
    "directory": "packages/config"
  },
  "homepage": "https://github.com/dryoung1029/jeldon#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./load": {
      "types": "./dist/load.d.ts",
      "import": "./dist/load.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "publish:dry": "pnpm -r publish --dry-run --no-git-checks"
  },
  "dependencies": {
    "jiti": "^2.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
