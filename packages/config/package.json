{
  "name": "@jeldon/config",
  "version": "0.2.0",
  "description": "The Jeldon Domain Pack contract: types, Zod schema, defaults, and loader. The single file a new project edits validates against this.",
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "jiti": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsup": "^9.0.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
