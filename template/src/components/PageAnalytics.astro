---
// Intent beacon for non-article pages. Sends one pageview and every
// book / call / contact tap to /api/track keyed by the normalized path, so the
// conversion map can show taps and request-sheet opens for service and
// location pages, not just form leads. Anonymous: path + event kind + time.
// Article pages should not include this (they carry their own beacon), or
// views are counted twice. Renders nothing for excluded paths (admin, api).
import { normalizeSitePath } from '@jeldon/crawler-analytics';
import { pack } from '../lib/pack';

const path = normalizeSitePath(Astro.url.pathname, pack.analytics ?? undefined) ?? '';
---
{path && (
<script is:inline define:vars={{ path }}>
  (function () {
    if (!navigator.sendBeacon) return;
    function beacon(payload) {
      try { navigator.sendBeacon('/api/track', new Blob([JSON.stringify(payload)], { type: 'text/plain' })); } catch (e) { /* never throw */ }
    }
    beacon({ t: 'view', path: path });
    document.addEventListener('click', function (ev) {
      var el = ev.target && ev.target.closest ? ev.target.closest('a[href], [data-cta]') : null;
      if (!el) return;
      var href = (el.getAttribute && el.getAttribute('href')) || '';
      var kind = '';
      if (el.dataset && el.dataset.cta) kind = el.dataset.cta;
      else if (/^tel:/i.test(href)) kind = 'call';
      else if (/#book/i.test(href) || /\/book(\/|$)/i.test(href)) kind = 'book';
      else if (/\/contact/i.test(href) || /^mailto:/i.test(href)) kind = 'contact';
      if (!kind) return;
      beacon({ t: 'cta', path: path, kind: kind, href: String(href).slice(0, 200) });
    }, true);
  })();
</script>
)}
