# Copy to `.dev.vars` (local wrangler preview) or set in the Cloudflare
# dashboard for the live site. Never commit real values. The authoritative list
# is `services.requiredEnv` in jeldon.config.ts; `jeldon doctor` verifies each.

# Store adapter (GitHub-as-database). Only when services.store is 'github'.
GITHUB_TOKEN=

# LLM key — only when capabilities.drafting is 'api'. Agent mode needs none.
ANTHROPIC_API_KEY=
