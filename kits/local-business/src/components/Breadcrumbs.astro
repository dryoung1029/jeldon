---
interface Props { items: { name: string; url: string }[] }
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="crumbs">
  <ol>
    <li><a href="/">Home</a></li>
    {items.map((c, i) => (
      <li>{i === items.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.url}>{c.name}</a>}</li>
    ))}
  </ol>
</nav>

<style>
  .crumbs ol { list-style: none; padding: 0; margin: 0 0 var(--s1); display: flex; flex-wrap: wrap; gap: 0.4em; font-size: var(--step--1); font-weight: 700; color: var(--fg-muted); }
  .crumbs li + li::before { content: '/'; margin-right: 0.4em; color: var(--line-strong); }
  .crumbs a { color: var(--fg-muted); text-decoration: none; }
  .crumbs a:hover { color: var(--primary); }
</style>
