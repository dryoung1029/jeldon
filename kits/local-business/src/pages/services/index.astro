---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ServiceList from '../../components/ServiceList.astro';
import { kit, labels, routes } from '../../lib/kit';
import { getServices } from '../../lib/content';
import { crumbs } from '../../lib/seo';

const services = await getServices();
const items = [{ name: labels.services.plural, url: routes.services }];
const city = kit.site.address?.city ? ` in ${kit.site.address.city}` : '';
---

<BaseLayout
  title={`${labels.services.plural}${city}`}
  description={`${labels.services.plural} at ${kit.site.name}${city}: ${services.map((s) => s.data.name.toLowerCase()).join(', ')}. ${labels.primaryCta.pitch ?? ''}`.trim().slice(0, 160)}
  jsonLd={[crumbs(items)]}
>
  <div class="container">
    <Breadcrumbs items={items} />
    <PageHeader title={labels.services.plural} lede={labels.services.lede} />
    {services.length ? <ServiceList services={services} /> : <p class="muted">SETUP: add {labels.services.plural.toLowerCase()} under {kit.collections.services}.</p>}
    <section class="section">
      <h2>Not sure which one?</h2>
      <p>{labels.primaryCta.pitch} Tell us what you're after and we'll point you to the right {labels.services.singular.toLowerCase()}.</p>
      <a class="btn btn--primary" href={kit.primaryCta.href}>{kit.primaryCta.label}</a>
    </section>
  </div>
</BaseLayout>
