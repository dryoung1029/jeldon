# Copy to `.dev.vars` for local preview (wrangler) or set these in the
# Cloudflare dashboard for the live site. Never commit real values.

# Lead sink: PushPress Platform API — developer.pushpress.com → API keys.
PUSHPRESS_API_KEY=
PUSHPRESS_COMPANY_ID=
# Lead sink: GoHighLevel / PushPress Grow inbound webhook (or set in kit.config.ts).
GHL_WEBHOOK_URL=

# Notifier: Brevo (SMTP & API → API keys) or Resend.
BREVO_API_KEY=
RESEND_API_KEY=
# Where lead emails go and who they appear to be from (a verified sender). BOTH required.
LEAD_NOTIFY_TO=
LEAD_NOTIFY_FROM=

# Cloudflare Turnstile (optional spam protection; site key goes in kit.config.ts).
TURNSTILE_SECRET_KEY=
